---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PracticeCard from '../components/PracticeCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Button from '../components/Button.astro';
import DisclaimerNotice from '../components/DisclaimerNotice.astro';
import {legacy,practices,contact} from '../data/site';
import latest from '../data/latest.json';
const courts=['Patna High Court','District Courts of Bihar','Bihar statutory forums','MSME Facilitation Council','Bihar RERA','Arbitral Tribunals','Delhi Courts & Forums','Supreme Court of India','Noida & Ghaziabad Forums','Allahabad High Court'];
---
<BaseLayout title="Chambers of AK | Advocates & Legal Consultants" description="General information about Chambers of AK, its practice areas, courts and legal resources.">
<DisclaimerNotice />
<section class="hero"><div class="wrap hero-grid"><div><p class="eyebrow">Advocates &amp; Legal Consultants · Patna, India</p><h1>Chambers of AK</h1><div class="rule"></div><p class="lead">A document-first legal chambers focused on MSME recovery, arbitration, commercial and consumer recovery, RERA, property and cheque bounce matters.</p><p class="muted">Primary practice before the Patna High Court, District Courts and forums of Bihar, with selected matters in other jurisdictions.</p><div class="cluster"><Button href="#practice">Practice areas</Button><Button variant="outline" href="#insights">Legal insights</Button></div></div><figure><img src="/assets/img/citadel/citadel-hero-hall.webp" alt="Architectural illustration of a court hall" fetchpriority="high" decoding="async"/><figcaption>Legal practice &amp; procedural information</figcaption></figure></div></section>
<section class="section wrap" id="about"><SectionHeading eyebrow="01 / The chambers" title="A document-first approach" description="Matters are assessed through documents, dates, procedural stage, limitation, forum and relief."/><div class="grid"><div class="panel"><h3>Documents</h3><p class="muted">Indexed papers, pleadings, agreements and evidence.</p></div><div class="panel"><h3>Procedure</h3><p class="muted">Chronology, limitation, jurisdiction and forum assessment.</p></div><div class="panel"><h3>Relief</h3><p class="muted">Identification of the legal issues and remedies relevant to the facts.</p></div></div><p class="more"><a href={legacy('about.html')}>About the chambers →</a></p></section>
<section class="section wrap" id="practice"><SectionHeading eyebrow="02 / Practice" title="Areas of practice"/><div class="grid">{practices.map(p=><PracticeCard {...p}/>)}</div><p class="more"><a href={legacy('practice.html')}>Full practice overview →</a></p></section>
<section class="section wrap" id="courts"><SectionHeading eyebrow="03 / Jurisdiction" title="Courts &amp; forums" description="Primary focus in Bihar, with selected matters before other courts and forums."/><ul class="courts">{courts.map(c=><li>{c}</li>)}</ul><p class="more"><a href={legacy('courts.html')}>Court and forum information →</a></p></section>
<section class="section wrap" id="insights"><SectionHeading eyebrow="04 / Legal insights" title="Recent articles" description="Legal updates, procedural guides, case notes and document checklists."/><div class="grid">{latest.map(a=><ArticleCard title={a.title} category={a.category} date={a.date} excerpt={a.excerpt} href={legacy(a.href)} image={'/'+a.cardThumbnail}/>)}</div><p class="more"><a href={legacy('legal-updates.html')}>Browse all legal insights →</a></p></section>
<section class="section wrap" id="resources"><SectionHeading eyebrow="05 / Resources" title="Legal information &amp; preparation"/><div class="grid">{[['Document checklists','document-checklists.html','Organise records and supporting documents.'],['Frequently asked questions','faq.html','General explanations of common legal issues.'],['Procedural overview','process.html','Understand document review and procedural stages.']].map(([title,path,description])=><article class="panel"><h3>{title}</h3><p class="muted">{description}</p><a href={legacy(path)}>Read information →</a></article>)}</div></section>
<section class="section wrap" id="contact"><SectionHeading eyebrow="06 / Contact information" title="Chambers of AK" description="Patna, Bihar, India"/><div class="panel contact"><div><p>Telephone: <a href={'tel:'+contact.tel}>{contact.phone}</a></p><p>Email: <a href={'mailto:'+contact.email}>{contact.email}</a></p><p class="muted">Contact does not establish an advocate-client relationship.</p></div><Button variant="outline" href={legacy('contact.html')}>Contact details</Button></div></section>
</BaseLayout>
<style>.hero{border-bottom:1px solid var(--line);padding-block:clamp(3rem,7vw,7rem)}.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;align-items:center;gap:clamp(2rem,5vw,5rem)}.lead{font-size:clamp(1rem,2vw,1.25rem);max-width:55ch}.hero .cluster{margin-top:1.75rem}figure{margin:0;border:1px solid var(--line);background:var(--surface);padding:.7rem}figure img{width:100%;aspect-ratio:4/3;object-fit:cover}figcaption{padding:.7rem .2rem .1rem;font-size:.75rem;color:var(--muted)}.grid{margin-top:1.8rem}.more{margin-top:1.5rem;color:var(--gold);font-size:.9rem}.courts{list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:0 1.5rem}.courts li{border-bottom:1px solid var(--line);padding:1rem 0}.contact{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;overflow-wrap:anywhere}.contact p:last-child{margin:0}@media(max-width:760px){.hero-grid{grid-template-columns:1fr}.hero figure{max-width:36rem}}</style>
