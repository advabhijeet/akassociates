---
import ThemeToggle from './ThemeToggle.astro';
import {navigation} from '../data/site';
---
<header class="site-header"><div class="wrap header-row"><a class="wordmark" href="/" aria-label="Chambers of AK home"><img class="light-logo" src="/assets/img/performance/logo-navbar-480.jpg" alt="Chambers of AK" width="480" height="89"/><img class="dark-logo" src="/assets/img/performance/logo-navbar-dark-480.jpg" alt="Chambers of AK" width="480" height="89"/></a><nav aria-label="Main navigation">{navigation.map(([label,href])=><a href={href.startsWith('#')?'/'+href:href}>{label}</a>)}<ThemeToggle /></nav></div></header>
<style>.site-header{border-bottom:1px solid var(--line);background:var(--surface)}.header-row{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding-block:1.1rem;flex-wrap:wrap}.wordmark{display:block;width:min(250px,100%)}.wordmark img{width:100%;height:auto}.dark-logo{display:none}:global([data-theme="dark"]) .dark-logo{display:block}:global([data-theme="dark"]) .light-logo{display:none}nav{display:flex;align-items:center;gap:clamp(.5rem,1.4vw,1.15rem);flex-wrap:wrap}nav a{font-size:.82rem;text-decoration:none;min-height:44px;display:flex;align-items:center}nav a:hover{color:var(--gold);text-decoration:underline}@media(max-width:850px){nav{width:100%;gap:.4rem 1rem}.header-row{gap:.4rem}}</style>
