---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Chambers of AK | Development preview" description="Private development-stage foundation for the Chambers of AK website.">
<section class="wrap hero"><p class="eyebrow">CHAMBERS OF AK / 2.0</p><h1>Advocates &amp;<br/>Legal Consultants</h1><p class="muted">Astro migration foundation. Existing legal content and production services remain on the current website.</p><a href="https://chambersofak.in/">Visit the existing website</a></section>
</BaseLayout>
<style>.hero { padding-block:clamp(4rem,12vw,9rem); } .eyebrow { letter-spacing:.18em; font-size:.75rem; color:var(--gold); } .muted { max-width:36rem; } a { text-underline-offset:.3em; }</style>
