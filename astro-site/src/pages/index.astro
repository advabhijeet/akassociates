---
import BaseLayout from '../layouts/BaseLayout.astro';
import DisclaimerNotice from '../components/DisclaimerNotice.astro';
import {legacy,practices,contact} from '../data/site';
import latest from '../data/latest.json';
const courts=['Patna High Court','District Courts of Bihar','Bihar statutory forums','MSME Facilitation Council','Bihar RERA','Arbitral Tribunals','Delhi Courts & Forums','Supreme Court of India','Noida & Ghaziabad Forums','Allahabad High Court'];
const resources=[['Document checklists','document-checklists.html','Organise records and supporting documents.'],['Frequently asked questions','faq.html','General explanations of common legal issues.'],['Procedural overview','process.html','Understand document review and procedural stages.']];
const approach=[['01','Documents','Indexed papers, pleadings, agreements and evidence.'],['02','Procedure','Chronology, limitation, jurisdiction and forum assessment.'],['03','Relief','Legal issues and remedies relevant to the facts.']];
const featured=latest[0];
---
<BaseLayout title="Chambers of AK | Advocates & Legal Consultants" description="General information about Chambers of AK, its practice areas, courts and legal resources.">
<DisclaimerNotice/>
<section class="hero" aria-labelledby="hero-title">
<img class="hero-image" src="/assets/img/citadel/citadel-hero-hall.webp" alt="" fetchpriority="high" decoding="async"/>
<div class="hero-shade"></div>
<div class="wrap hero-inner"><div class="hero-copy"><p class="hero-kicker"><span></span> Advocates &amp; Legal Consultants</p><h1 id="hero-title">Chambers<br/><em>of AK</em></h1><p class="hero-lead">A document-first legal chambers focused on MSME recovery, arbitration, commercial and consumer recovery, RERA, property and cheque bounce matters.</p><div class="hero-links"><a class="gold-button" href="#practice">Areas of practice <span aria-hidden="true">↗</span></a><a class="ghost-button" href="#insights">Legal insights <span aria-hidden="true">↗</span></a></div></div>
<div class="hero-index"><span>01 — CHAMBERS OF AK</span><span>Patna · Bihar · India</span></div></div>
</section>
<div class="context-strip"><div class="wrap context-grid"><div><span class="tiny">Primary jurisdiction</span><strong>Patna High Court &amp; Bihar forums</strong></div><div><span class="tiny">Practice focus</span><strong>Disputes, recovery &amp; arbitration</strong></div><div><span class="tiny">Legal information</span><strong>Articles, procedures &amp; checklists</strong></div></div></div>
<section class="wrap section editorial" id="about"><div class="section-intro"><p class="eyebrow">01 / The chambers</p><h2>A document-first<br/>approach.</h2><p class="intro-copy">Matters are assessed through documents, dates, procedural stage, limitation, forum and relief.</p><a class="text-link" href={legacy('about.html')}>About the chambers <span aria-hidden="true">↗</span></a></div><div class="approach-list">{approach.map(([n,title,description])=><article><span class="index">{n}</span><div><h3>{title}</h3><p>{description}</p></div></article>)}</div></section>
<section class="practice-section section" id="practice"><div class="wrap"><div class="section-top"><div><p class="eyebrow">02 / Practice</p><h2>Areas of practice</h2></div><a class="text-link" href={legacy('practice.html')}>Full practice overview <span aria-hidden="true">↗</span></a></div><div class="practice-grid">{practices.map(p=><a class="practice-tile" href={p.href}><span class="index">{p.number} /</span><h3>{p.title}</h3><p>{p.description}</p><span class="tile-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="jurisdiction" id="courts"><div class="jurisdiction-art"><img src="/assets/img/citadel/citadel-tribunal-room.webp" alt="Illustrative interior of a legal hearing room" loading="lazy" decoding="async"/></div><div class="jurisdiction-content"><p class="eyebrow">03 / Jurisdiction</p><h2>Courts &amp; forums</h2><p>Primary focus in Bihar, with selected matters before other courts and forums.</p><ul>{courts.map(c=><li>{c}</li>)}</ul><a class="text-link" href={legacy('courts.html')}>Court and forum information <span aria-hidden="true">↗</span></a></div></section>
<section class="wrap section" id="insights"><div class="section-top"><div><p class="eyebrow">04 / Legal insights</p><h2>Recent articles</h2><p class="intro-copy">Legal updates, procedural guides, case notes and document checklists.</p></div><a class="text-link" href={legacy('legal-updates.html')}>Browse all legal insights <span aria-hidden="true">↗</span></a></div><div class="journal"><article class="feature"><a href={legacy(featured.href)} class="feature-image" aria-label={featured.title}><img src={'/'+featured.cardThumbnail} alt="" width="640" height="360" loading="lazy" decoding="async"/></a><div class="article-meta"><span>{featured.category}</span><span class="date">{featured.date}</span></div><h3><a href={legacy(featured.href)}>{featured.title}</a></h3><p>{featured.excerpt}</p><a class="text-link" href={legacy(featured.href)}>Read article <span aria-hidden="true">↗</span></a></article><div class="journal-list">{latest.slice(1).map(a=><article><a href={legacy(a.href)} class="news-image" tabindex="-1" aria-label={a.title}><img src={'/'+a.cardThumbnail} alt="" width="640" height="360" loading="lazy" decoding="async"/></a><div><div class="article-meta"><span>{a.category}</span><span class="date">{a.date}</span></div><h3><a href={legacy(a.href)}>{a.title}</a></h3></div></article>)}</div></div></section>
<section class="resources section" id="resources"><div class="wrap editorial"><div class="section-intro"><p class="eyebrow">05 / Resources</p><h2>Legal information<br/>&amp; preparation.</h2><p class="intro-copy">General educational material for organising documents and understanding procedural issues.</p><img class="resource-art" src="/assets/img/citadel/citadel-legal-documents-card.webp" alt="" loading="lazy" decoding="async"/></div><div class="resource-list">{resources.map(([title,path,description],i)=><a href={legacy(path)}><span class="index">0{i+1}</span><div><h3>{title}</h3><p>{description}</p></div><span class="resource-arrow" aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="wrap section contact-section" id="contact"><div><p class="eyebrow">06 / Contact information</p><h2>Chambers of AK</h2><p class="intro-copy">Patna, Bihar, India. Contact does not establish an advocate-client relationship.</p></div><div class="contact-details"><a href={'tel:'+contact.tel}>{contact.phone}</a><a href={'mailto:'+contact.email}>{contact.email}</a><a class="text-link" href={legacy('contact.html')}>Contact details <span aria-hidden="true">↗</span></a></div></section>
</BaseLayout>
<style>
.hero{position:relative;background:#1c211e;color:#fffaf0;isolation:isolate;overflow:hidden}
.hero-image,.hero-shade{position:absolute;inset:0;width:100%;height:100%;z-index:-1}.hero-image{object-fit:cover;object-position:62% center}.hero-shade{background:linear-gradient(90deg,#131815f5 0%,#131815e8 30%,#131815ad 63%,#13181540 100%),linear-gradient(0deg,#11161385,transparent 65%)}
.hero-inner{min-height:clamp(540px,69vh,760px);display:flex;flex-direction:column;justify-content:center;position:relative;padding-block:5rem 6.2rem}
.hero-copy{max-width:680px}.hero-kicker{font-size:.74rem;letter-spacing:.2em;text-transform:uppercase;color:#e4c58e;display:flex;align-items:center;gap:.8rem;margin-bottom:1.7rem}.hero-kicker span{width:2.3rem;height:1px;background:#e4c58e}
.hero h1{font-size:clamp(4.2rem,9.8vw,8.6rem);line-height:.86;letter-spacing:-.065em;margin:0 0 1.9rem;overflow-wrap:normal}.hero h1 em{font-weight:400;color:#e1c390}.hero-lead{font-size:clamp(1rem,1.4vw,1.18rem);max-width:49ch;color:#e7e6df;line-height:1.75}
.hero-links{display:flex;gap:.8rem;flex-wrap:wrap;margin-top:2rem}.gold-button,.ghost-button{display:inline-flex;align-items:center;justify-content:space-between;gap:1.4rem;min-height:50px;padding:.75rem 1.2rem;font-size:.84rem;font-weight:650;text-decoration:none;border:1px solid #d7b477}.gold-button{background:#d7b477;color:#171a17}.ghost-button{color:#fffaf0;background:#171a173b}.gold-button:hover,.ghost-button:hover{background:#f0d6a5;color:#171a17}
.hero-index{position:absolute;bottom:1.4rem;left:0;right:0;display:flex;justify-content:space-between;gap:.6rem;border-top:1px solid #ffffff36;padding-top:.8rem;font-size:.65rem;letter-spacing:.14em;text-transform:uppercase;color:#e8ddc8}
.context-strip{background:#202522;color:#f5f0e6;border-top:1px solid #ffffff26}.context-grid{display:grid;grid-template-columns:repeat(3,1fr)}.context-grid>div{padding:1.25rem 1.3rem;border-right:1px solid #ffffff23}.context-grid>div:first-child{padding-left:0}.context-grid>div:last-child{border:0}.tiny{display:block;color:#d7b477;font-size:.65rem;text-transform:uppercase;letter-spacing:.14em;margin-bottom:.4rem}.context-grid strong{font:1.1rem/1.3 var(--serif)}
.editorial{display:grid;grid-template-columns:1fr 1.15fr;gap:clamp(2rem,7vw,7rem);align-items:start}.section-intro h2,.section-top h2,.contact-section h2{font-size:clamp(2.5rem,5vw,4.6rem);line-height:1.02}.intro-copy{color:var(--muted);max-width:52ch}.text-link{display:inline-flex;align-items:center;gap:.75rem;color:var(--gold);font-size:.86rem;font-weight:650;text-decoration:none;border-bottom:1px solid var(--gold-line);padding:.3rem 0;min-height:44px}.text-link:hover{border-bottom-width:2px}.text-link span{font-size:1.1rem}
.approach-list{border-top:1px solid var(--line)}.approach-list article{display:grid;grid-template-columns:3.2rem 1fr;gap:1.1rem;border-bottom:1px solid var(--line);padding:1.4rem 0}.index{font-size:.74rem;letter-spacing:.13em;color:var(--gold);font-weight:650}.approach-list h3,.approach-list p{margin:0}.approach-list p{color:var(--muted);margin-top:.3rem}
.practice-section{background:var(--surface);border-block:1px solid var(--line)}.section-top{display:flex;justify-content:space-between;align-items:end;gap:1.5rem;flex-wrap:wrap;margin-bottom:2.4rem}.section-top h2{margin-bottom:.4rem}.section-top p:last-child{margin-bottom:0}
.practice-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line);border-left:1px solid var(--line)}.practice-tile{position:relative;min-height:245px;display:flex;flex-direction:column;align-items:start;text-decoration:none;padding:1.8rem 1.8rem 3.4rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line);transition:background .18s,color .18s}.practice-tile h3{font-size:clamp(1.55rem,2.5vw,2.1rem);margin:1.2rem 0 .6rem}.practice-tile p{font-size:.91rem;color:var(--muted);margin:0}.tile-arrow{position:absolute;right:1.5rem;bottom:1.05rem;color:var(--gold);font-size:1.35rem}.practice-tile:hover,.practice-tile:focus-visible{background:var(--paper)}.practice-tile:hover .tile-arrow{transform:translate(2px,-2px)}
.jurisdiction{display:grid;grid-template-columns:.85fr 1.15fr;background:#202522;color:#f5f0e6;min-height:470px}.jurisdiction-art{min-height:300px;position:relative}.jurisdiction-art img{position:absolute;width:100%;height:100%;object-fit:cover;inset:0}.jurisdiction-content{padding:clamp(2rem,5vw,5rem);max-width:800px}.jurisdiction-content h2{font-size:clamp(2.5rem,4vw,4rem)}.jurisdiction-content .eyebrow,.jurisdiction-content .text-link{color:#e2c58e}.jurisdiction-content p:not(.eyebrow){color:#d2d3cd}.jurisdiction-content ul{padding:0;list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:.5rem 1.2rem;margin:1.5rem 0}.jurisdiction-content li{font-size:.87rem;border-bottom:1px solid #ffffff25;padding:.55rem 0}
.journal{display:grid;grid-template-columns:1.15fr 1fr;gap:clamp(1.5rem,5vw,4rem)}.feature{min-width:0}.feature-image,.news-image{display:block;background:#e6dfd1;overflow:hidden}.feature-image img,.news-image img{width:100%;height:auto;aspect-ratio:16/9;object-fit:contain}.article-meta{display:flex;gap:.5rem 1rem;flex-wrap:wrap;font-size:.68rem;color:var(--muted);margin:1rem 0 .6rem}.article-meta span{color:var(--gold);font-weight:650;text-transform:uppercase;letter-spacing:.08em}.feature h3{font-size:clamp(1.75rem,3.2vw,2.75rem);line-height:1.15}.journal h3 a{text-decoration:none}.journal h3 a:hover{text-decoration:underline}.feature p{color:var(--muted)}.journal-list{border-top:1px solid var(--line)}.journal-list article{display:grid;grid-template-columns:minmax(95px,34%) 1fr;align-items:start;gap:1rem;padding:1.15rem 0;border-bottom:1px solid var(--line)}.journal-list .article-meta{margin:0 0 .45rem}.journal-list h3{font-size:clamp(1.1rem,1.9vw,1.5rem);margin:0;line-height:1.22}
.resources{background:var(--surface);border-block:1px solid var(--line)}.resource-art{width:min(100%,310px);aspect-ratio:16/9;object-fit:cover;margin-top:1.5rem}.resource-list{border-top:1px solid var(--line)}.resource-list a{display:grid;grid-template-columns:2rem 1fr 1.5rem;align-items:start;gap:.8rem;border-bottom:1px solid var(--line);padding:1.5rem 0;text-decoration:none}.resource-list a:hover h3{text-decoration:underline}.resource-list h3,.resource-list p{margin:0}.resource-list p{color:var(--muted);font-size:.9rem;margin-top:.4rem}.resource-arrow{color:var(--gold);font-size:1.25rem}
.contact-section{display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:center}.contact-details{display:grid;gap:.7rem;justify-items:start;overflow-wrap:anywhere}.contact-details>a:not(.text-link){font-family:var(--serif);font-size:clamp(1.1rem,2vw,1.6rem)}
@media(max-width:800px){.hero-inner{min-height:540px}.hero-shade{background:linear-gradient(90deg,#131815ed,#131815a8),linear-gradient(0deg,#13181580,transparent)}.editorial,.journal,.jurisdiction,.contact-section{grid-template-columns:1fr}.practice-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.jurisdiction-art{min-height:220px}.context-grid{grid-template-columns:1fr}.context-grid>div,.context-grid>div:first-child{padding:.85rem 0;border-right:0;border-bottom:1px solid #ffffff23}.context-grid>div:last-child{border:0}}
@media(max-width:480px){.hero h1{font-size:clamp(3.6rem,15vw,4.6rem)}.hero-inner{min-height:540px;padding-block:3.2rem 5rem}.hero-index{font-size:.55rem}.hero-kicker{letter-spacing:.12em}.practice-grid{grid-template-columns:1fr}.practice-tile{min-height:190px;padding:1.35rem 1.25rem 3rem}.jurisdiction-content ul{grid-template-columns:1fr}.journal-list article{gap:.7rem}.journal-list .article-meta{font-size:.62rem}}

/* V3: calibrated hero, neutral palette and finer details. */
.hero{background:#090909}
.hero-shade{background:linear-gradient(90deg,rgba(0,0,0,.94) 0%,rgba(0,0,0,.83) 32%,rgba(0,0,0,.46) 62%,rgba(0,0,0,.09) 100%),linear-gradient(0deg,rgba(0,0,0,.42),transparent 60%)}
.hero-inner{min-height:clamp(465px,64vh,650px);padding-block:2.6rem 4.2rem}
.hero-copy{max-width:630px}
.hero-kicker{margin-bottom:1.15rem;letter-spacing:.16em;color:#e6c68c}
.hero h1{font-size:clamp(3.9rem,7vw,6.25rem);line-height:.94;letter-spacing:-.048em;margin-bottom:1.15rem}
.hero h1 em{font-style:normal;color:#e0bf85}
.hero-lead{font-size:clamp(.98rem,1.3vw,1.12rem);line-height:1.65;max-width:52ch;margin-bottom:0;color:#f0ece3}
.hero-links{margin-top:1.4rem}
.gold-button,.ghost-button{min-height:46px;letter-spacing:.015em;border-color:#d5b47a}
.gold-button{background:#dfbd7e;color:#111}
.ghost-button{background:#0005;color:#fff}
.gold-button:hover,.ghost-button:hover{color:#111}
.hero-index{bottom:1rem;color:#e9dbc1;letter-spacing:.12em}
.context-strip,.jurisdiction{background:#0b0b0b}
.context-strip{border-top:1px solid #6f5732;border-bottom:1px solid #4d3920}
.context-grid>div{border-color:#443b2d;padding-block:1.05rem}
.context-grid strong{font-size:1.15rem}
.jurisdiction-content{border-top:1px solid #4d3920}
.section-intro h2,.section-top h2,.contact-section h2{font-size:clamp(2.3rem,4.3vw,3.85rem)}
.practice-tile{min-height:218px;padding:1.55rem 1.65rem 3rem}
.practice-tile:hover,.practice-tile:focus-visible{box-shadow:inset 0 3px 0 var(--gold-line)}
.practice-tile h3{margin-top:.85rem}
.journal{gap:clamp(1.5rem,4vw,3.5rem)}
.feature{padding-bottom:.75rem}
.feature-image{border:1px solid var(--line)}
.feature-image img,.news-image img{object-fit:contain}
.journal-list article{padding:1rem 0}
.article-meta .date{color:var(--muted);font-weight:400;letter-spacing:0;text-transform:none}
.resource-list a:hover{background:var(--paper)}
:global([data-theme="dark"]) .practice-section,:global([data-theme="dark"]) .resources{background:#101010}
@media(max-width:800px){.hero-inner{min-height:480px;padding-block:2.5rem 4.1rem}.hero-shade{background:linear-gradient(90deg,rgba(0,0,0,.91),rgba(0,0,0,.54)),linear-gradient(0deg,rgba(0,0,0,.3),transparent)}.context-grid>div,.context-grid>div:first-child{padding:.75rem 0}.practice-tile{min-height:205px}}
@media(max-width:480px){.hero h1{font-size:clamp(3.1rem,13vw,4.2rem)}.hero-inner{min-height:470px;padding-block:2.3rem 4rem}.hero-kicker{letter-spacing:.1em;font-size:.67rem}.hero-index{font-size:.55rem}.hero-links{gap:.55rem}.gold-button,.ghost-button{padding:.65rem .8rem;gap:.7rem}.practice-tile{min-height:180px;padding:1.25rem 1.2rem 2.8rem}}
</style>
