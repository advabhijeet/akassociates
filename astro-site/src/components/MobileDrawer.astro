---
import { navigation, legacy } from '../data/site';
---
<div class="mobile-drawer-control">
  <button class="menu-trigger" type="button" aria-label="Open navigation menu" aria-controls="mobile-drawer" aria-expanded="false" data-drawer-open>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round"/></svg><span>Menu</span>
  </button>
  <noscript><a class="no-script-menu" href="/#practice">Practice</a> <a class="no-script-menu" href="/#insights">Insights</a></noscript>
</div>
<dialog id="mobile-drawer" class="mobile-drawer" aria-labelledby="drawer-title" data-mobile-drawer>
  <div class="drawer-shell">
    <div class="drawer-head">
      <a href="/" class="drawer-brand" aria-label="Chambers of AK home"><img class="logo-light" src="/assets/img/performance/logo-navbar-480.jpg" alt="Chambers of AK" width="480" height="89"/><img class="logo-dark" src="/assets/img/performance/logo-navbar-dark-480.jpg" alt="Chambers of AK" width="480" height="89"/></a>
      <button type="button" class="drawer-close" aria-label="Close navigation menu" data-drawer-close autofocus><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" stroke-linecap="round"/></svg></button>
    </div>
    <div class="drawer-content">
      <p id="drawer-title" class="drawer-label">Navigation</p>
      <nav aria-label="Mobile navigation">
        {navigation.map(([label,href],i)=><a href={href.startsWith('#')?'/'+href:href}><span class="nav-number">{String(i+1).padStart(2,'0')}</span><span class="nav-label">{label}</span><span class="nav-arrow" aria-hidden="true">↗</span></a>)}
      </nav>
      <div class="drawer-secondary"><a href={legacy('disclaimer.html')}>Disclaimer</a><a href={legacy('privacy-policy.html')}>Privacy policy</a></div>
    </div>
    <div class="drawer-footer"><span>Advocates &amp; Legal Consultants</span><span>Patna · Bihar · India</span></div>
  </div>
</dialog>
<script>
  const dialog=document.querySelector<HTMLDialogElement>('[data-mobile-drawer]');
  const trigger=document.querySelector<HTMLButtonElement>('[data-drawer-open]');
  const closeButton=dialog?.querySelector<HTMLButtonElement>('[data-drawer-close]');
  const desktop=matchMedia('(min-width:1051px)');
  let timer:number|undefined;
  function finish(){
    if(timer!==undefined){window.clearTimeout(timer);timer=undefined;}
    dialog?.removeAttribute('data-closing');
    if(dialog?.open)dialog.close();
  }
  function dismiss(animated=true){
    if(!dialog?.open)return;
    if(!animated||matchMedia('(prefers-reduced-motion: reduce)').matches){finish();return;}
    if(dialog.hasAttribute('data-closing'))return;
    dialog.setAttribute('data-closing','');
    timer=window.setTimeout(finish,320);
  }
  trigger?.addEventListener('click',()=>{
    if(!dialog||dialog.open||desktop.matches)return;
    dialog.showModal();
    trigger.setAttribute('aria-expanded','true');
    document.documentElement.classList.add('mobile-drawer-open');
    closeButton?.focus();
  });
  closeButton?.addEventListener('click',()=>dismiss());
  dialog?.addEventListener('cancel',event=>{event.preventDefault();dismiss();});
  dialog?.addEventListener('click',event=>{if(event.target===dialog)dismiss();});
  dialog?.addEventListener('animationend',event=>{if(event.target===dialog&&dialog.hasAttribute('data-closing'))finish();});
  dialog?.addEventListener('close',()=>{
    if(timer!==undefined){window.clearTimeout(timer);timer=undefined;}
    dialog.removeAttribute('data-closing');
    document.documentElement.classList.remove('mobile-drawer-open');
    trigger?.setAttribute('aria-expanded','false');
    if(!desktop.matches&&document.activeElement===document.body)trigger?.focus({preventScroll:true});
  });
  dialog?.querySelectorAll('a').forEach(a=>a.addEventListener('click',event=>{
    if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;
    dismiss(false);
  }));
  desktop.addEventListener('change',event=>{if(event.matches)dismiss(false);});
</script>
<style>
.mobile-drawer-control{display:none}
.menu-trigger,.drawer-close{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:44px;min-width:44px;color:var(--gold);border:1px solid var(--brand-border);background:transparent;border-radius:2px;padding:.45rem .7rem;font-size:.8rem;font-weight:600}
.menu-trigger:hover,.drawer-close:hover{border-color:var(--gold-line)}
.mobile-drawer{position:fixed;inset:0 0 0 auto;margin:0;padding:0;border:0;border-left:1px solid var(--gold-line);width:min(88vw,390px);max-width:100vw;height:100%;height:100dvh;max-height:none;background:var(--brand-header);color:var(--ink);overflow:hidden;box-shadow:-16px 0 60px #0005}
.mobile-drawer[open]{animation:drawer-in .28s cubic-bezier(.22,.8,.25,1) both}
.mobile-drawer::backdrop{background:rgba(0,0,0,.64);animation:backdrop-in .28s ease both}
.mobile-drawer[data-closing]{animation:drawer-out .24s ease-in both}
.mobile-drawer[data-closing]::backdrop{animation:backdrop-out .24s ease both}
.drawer-shell{height:100%;display:flex;flex-direction:column;overflow-y:auto;overscroll-behavior:contain;padding:1.35rem 1.4rem max(1.35rem,env(safe-area-inset-bottom));}
.drawer-head{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-bottom:1.4rem;border-bottom:1px solid var(--brand-border)}
.drawer-brand{width:min(225px,70%)}.drawer-brand img{width:100%;height:auto}.logo-light{mix-blend-mode:multiply}.logo-dark{display:none}:global([data-theme="dark"]) .logo-light{display:none}:global([data-theme="dark"]) .logo-dark{display:block;mix-blend-mode:screen}
.drawer-close{padding:.5rem;flex-shrink:0}
.drawer-content{padding-block:1.5rem 2rem;flex:1}
.drawer-label{color:var(--gold);font-size:.67rem;font-weight:650;letter-spacing:.17em;text-transform:uppercase;margin:0 0 1rem}
.drawer-content nav a{display:grid;grid-template-columns:1.6rem 1fr auto;align-items:center;gap:.6rem;min-height:58px;border-bottom:1px solid var(--line);text-decoration:none}
.nav-number{color:var(--gold);font-size:.65rem;letter-spacing:.05em}.nav-label{font-family:var(--serif);font-size:1.55rem;line-height:1.2}.nav-arrow{font-size:1.1rem;color:var(--gold)}
.drawer-content nav a:hover,.drawer-content nav a:focus-visible{color:var(--gold)}
.drawer-secondary{display:flex;gap:1rem;flex-wrap:wrap;margin-top:1.5rem;font-size:.78rem;color:var(--muted)}
.drawer-secondary a{padding:.4rem 0}
.drawer-footer{display:grid;gap:.3rem;border-top:1px solid var(--brand-border);padding-top:1rem;color:var(--muted);font-size:.72rem;letter-spacing:.04em}
.drawer-footer span:first-child{color:var(--gold)}
:global(html.mobile-drawer-open){overflow:hidden}
@keyframes drawer-in{from{transform:translateX(100%)}to{transform:translateX(0)}}
@keyframes drawer-out{from{transform:translateX(0)}to{transform:translateX(100%)}}
@keyframes backdrop-in{from{opacity:0}to{opacity:1}}
@keyframes backdrop-out{from{opacity:1}to{opacity:0}}
@media(max-width:1050px){.mobile-drawer-control{display:block}}
@media(max-width:560px){.menu-trigger span{display:none}.menu-trigger{padding:.45rem}.drawer-shell{padding-inline:1.1rem}}
@media(prefers-reduced-motion:reduce){.mobile-drawer,.mobile-drawer::backdrop{animation:none!important}}
</style>
