---
import BaseLayout from '../layouts/BaseLayout.astro';
const tools=[
 {id:'msme-due',title:'MSME payment due date',law:'MSMED Act · Sections 2, 15 & 16',desc:'Estimate payment deadline and interest commencement from acceptance or deemed acceptance.',fields:[['acceptance','Acceptance / deemed acceptance','date'],['agreed','Written agreed payment date (optional)','date']],source:'/updates/msme-45-days-payment-rule.html',note:'Enter the legally established acceptance date, including removal of timely written objections where applicable. No written date: payment before appointed day (day 16). Written terms are capped at 45 days. Does not determine supplier eligibility.'},
 {id:'msme-interest',title:'MSME statutory interest estimate',law:'MSMED Act · Section 16',desc:'Estimate compound interest at three times the RBI Bank Rate, with monthly rests.',fields:[['principal','Unpaid principal (₹)','number'],['rate','RBI Bank Rate (% per annum, not repo rate)','number'],['start','Interest commencement date','date'],['end','Calculation end date','date']],source:'/updates/section-16-msmed-act-compound-interest.html',note:'Assumes one constant Bank Rate, one unpaid balance, completed monthly anniversaries compounded at annual rate ÷ 12, residual days on Actual/365, and end-exclusive elapsed time. No rate changes, part payments or disputed amounts. Verify the applicable rate history and calculation convention before relying on the amount.'},
 {id:'section34',title:'Section 34 limitation',law:'Arbitration and Conciliation Act · Section 34(3)',desc:'Calculate the ordinary three calendar months and further 30-day discretionary period.',fields:[['start','Signed award receipt / valid Section 33 disposal date','date']],source:'/updates/section-34-arbitration-limitation-3-months-30-days.html',note:'Use the legally operative date, not simply award date. Only a valid Section 33 request changes the trigger. The additional 30 days require sufficient cause and court approval; no automatic extension. Does not account for holidays, exclusions, special orders or defects in filing.'},
 {id:'cheque',title:'Cheque bounce timeline',law:'NI Act · Sections 138 & 142',desc:'Estimate notice deadline, payment period, cause of action and complaint deadline.',fields:[['info','Date payee received dishonour information','date'],['sent','Actual notice dispatch date (optional)','date'],['served','Actual / legally deemed service date (optional)','date']],source:'/updates/section-138-cheque-bounce-limitation.html',note:'Assumes valid presentment, timely statutory notice, valid service and no payment within 15 days. Excludes trigger dates; complaint period is one calendar month. No adjustment for holidays, condonation or contested service.'},
 {id:'deposit',title:'MSME award pre-deposit',law:'MSMED Act · Section 19',desc:'Calculate 75% of the amount in terms of the award or order.',fields:[['award','Applicable award / order amount (₹)','number'],['paid','Qualifying deposit already made (optional, ₹)','number']],source:'/updates/section-19-msmed-act-75-percent-pre-deposit.html',note:'Arithmetic only for applicable non-supplier challenges. Enter the full legally relevant award/order amount, not just principal. Verify current commencement notifications, court directions and eligible deposits.'},
 {id:'rera',title:'RERA simple interest estimate',law:'RERA Act · Section 18 and applicable rules',desc:'Estimate simple interest for a single amount at a user-confirmed annual rate.',fields:[['principal','Applicable principal (₹)','number'],['rate','Applicable annual interest rate (%)','number'],['start','Interest commencement date','date'],['end','Calculation end date','date']],source:'/updates/rera-refund-interest-delayed-possession.html',note:'Illustrative single-payment simple interest using actual elapsed days ÷ 365. No state-specific rate assumed. Verify governing rules, payment-wise accrual, rate changes and authority orders.'}
];
const checklists=[['MSME',['Udyam certificate and registration date','Purchase/work orders','Invoice-wise statement','Delivery or completion evidence','Ledger and part-payment records','Buyer objections and acknowledgements']],['Arbitration',['Contract and arbitration clause','Invocation notice and service proof','Pleadings and evidence','Orders and signed award','Receipt and Section 33 dates']],['Cheque bounce',['Original cheque','Return memo and information date','Demand notice and dispatch proof','Service proof','Underlying transaction and payment records']],['RERA',['Builder-buyer agreement','Allotment and project details','Payment receipts and ledger','Possession schedule','Correspondence and notices']],['Commercial recovery',['Contract or purchase order','Invoices and ledger','Delivery/service proof','Demand notices and replies']],['Property / Civil',['Title deeds and chain','Mutation and revenue records','Possession and boundary records','Prior orders and notices']]];
const glossary=[['Appointed day','Day immediately following the expiry of 15 days from acceptance or deemed acceptance under the MSMED Act.'],['MSEFC','Micro and Small Enterprises Facilitation Council.'],['Monthly rests','Periodic capitalization of interest at monthly intervals, subject to the applicable calculation convention.'],['Arbitral award','Decision of an arbitral tribunal, subject to the applicable statutory framework.'],['Limitation','Time period prescribed by law for a proceeding or remedy.'],['Pre-deposit','Deposit required under a statutory provision before the relevant challenge is entertained.']];
---
<BaseLayout title="Legal Calculators & Resources | Chambers of AK" description="General legal calculators, document checklists and glossary for MSME, arbitration, cheque dishonour and RERA matters.">
<Fragment slot="head"><link rel="canonical" href="https://chambersofak.in/legal-tools.html"/></Fragment>
<section class="tools-hero"><div class="wrap"><p class="eyebrow">Chambers of AK / Resources</p><h1>Legal tools &amp; resources</h1><p>Document-first utilities for indicative dates, interest and preparation. Inputs remain in your browser; no personal data is required.</p><nav aria-label="Resource sections"><a href="#calculators">Calculators</a><a href="#checklists">Document checklists</a><a href="#glossary">Glossary</a><a href="#official">Official resources</a></nav></div></section>
<div class="wrap section"><p class="tools-warning"><strong>Important:</strong> General information and arithmetic only. These tools cannot determine limitation, maintainability, legal entitlement or the final amount payable. Verify the applicable law, documents, court calendar and orders independently.</p>
<section id="calculators"><p class="eyebrow">01 / Utilities</p><h2>Legal calculators</h2><div class="tools-grid">{tools.map(t=><article id={t.id} class="tool-card"><p class="eyebrow">{t.law}</p><h3>{t.title}</h3><p class="muted">{t.desc}</p><form data-tool={t.id} class="stack" method="post"><fieldset disabled class="stack">{t.fields.map(([name,label,type])=><label class="field">{label}<input name={name} type={type} required={!label.includes('optional')} min={type==='number'?0:undefined} step={type==='number'?'any':undefined}/></label>)}<div class="cluster"><button type="submit">Calculate</button><button type="reset" class="secondary">Reset</button></div><div data-result role="status" aria-live="polite" class="tool-result" hidden></div></fieldset></form><noscript><p>JavaScript is required for this local calculator.</p></noscript><details class="assumptions"><summary>Assumptions &amp; legal cautions</summary><p>{t.note}</p><a href={t.source}>Related legal guide →</a></details></article>)}</div></section>
<section id="checklists" class="section"><p class="eyebrow">02 / Preparation</p><h2>Interactive document checklists</h2><p class="muted">Select documents available for your matter. Nothing is saved or transmitted.</p><div class="tools-grid">{checklists.map(([title,items])=><article class="tool-card" data-checklist><h3>{title}</h3><p data-count aria-live="polite">0 of {(items as string[]).length} ready</p>{(items as string[]).map(item=><label class="check-item"><input type="checkbox"/><span>{item}</span></label>)}<button type="button" data-reset-check class="secondary">Clear checklist</button></article>)}</div><p><a href="/document-checklists.html">Full document preparation guide →</a></p></section>
<section id="glossary" class="section"><p class="eyebrow">03 / Terminology</p><h2>Legal glossary</h2><dl class="glossary">{glossary.map(([term,meaning])=><div><dt>{term}</dt><dd>{meaning}</dd></div>)}</dl></section>
<section id="official" class="section"><p class="eyebrow">04 / Primary resources</p><h2>Official legal resources</h2><div class="tools-grid">{[['India Code','https://www.indiacode.nic.in/'],['Supreme Court of India','https://www.sci.gov.in/'],['eCourts Services','https://services.ecourts.gov.in/'],['Patna High Court','https://patnahighcourt.gov.in/'],['Bihar RERA','https://rera.bihar.gov.in/'],['Udyam registration','https://udyamregistration.gov.in/'],['Reserve Bank of India','https://www.rbi.org.in/'],['Government eGazette','https://egazette.gov.in/']].map(([label,href])=><a class="official-link" href={href} target="_blank" rel="noopener noreferrer">{label}<span aria-hidden="true">↗</span></a>)}</div><p><a href="/courts.html">Courts and forums overview →</a></p></section></div>
</BaseLayout>
<script>
import {msmeDue,section34,chequeTimeline,interest,deposit} from '../data/legal-calculations.mjs';
const labels:Record<string,string>={due:'Payment deadline',interestStart:'Interest begins',ceiling:'45-day ceiling',appointed:'Appointed day (no written agreement)',normal:'Ordinary filing deadline',outer:'End of discretionary 30-day period',notice:'Notice dispatch deadline',sentLate:'Notice dispatched after estimated deadline',pay:'Payment period ends',cause:'Cause of action arises if unpaid',complaint:'Ordinary complaint deadline',principal:'Principal',interest:'Estimated interest',total:'Estimated total',days:'Elapsed days',months:'Completed monthly rests',annualRate:'Annual rate (%)',required:'75% pre-deposit',balance:'Estimated remaining deposit'};
document.querySelectorAll<HTMLFormElement>('[data-tool]').forEach(form=>{const result=form.querySelector<HTMLElement>('[data-result]');const clear=()=>{if(result){result.hidden=true;result.replaceChildren();}};form.addEventListener('input',clear);form.addEventListener('reset',clear);form.addEventListener('submit',event=>{event.preventDefault();if(!result)return;result.replaceChildren();try{const d=new FormData(form);const val=(k:string)=>String(d.get(k)||'');let data:Record<string,unknown>;switch(form.dataset.tool){case 'msme-due':data=msmeDue(val('acceptance'),val('agreed'));break;case 'msme-interest':if(!val('rate'))throw Error('Enter RBI Bank Rate.');data=interest(val('principal'),String(Number(val('rate'))*3),val('start'),val('end'),true);break;case 'section34':data=section34(val('start'));break;case 'cheque':data=chequeTimeline(val('info'),val('sent'),val('served'));break;case 'deposit':data=deposit(val('award'),val('paid'));break;case 'rera':data=interest(val('principal'),val('rate'),val('start'),val('end'),false);break;default:throw Error('Unknown calculator.');}const dl=document.createElement('dl');for(const [key,value] of Object.entries(data)){if(key==='months'&&form.dataset.tool==='rera')continue;const dt=document.createElement('dt'),dd=document.createElement('dd');dt.textContent=labels[key]||key;dd.textContent=typeof value==='boolean'?(value?'Yes — verify validity':'No'):/^\d{4}-\d{2}-\d{2}$/.test(String(value))?new Date(String(value)+'T00:00:00Z').toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}):String(value);dl.append(dt,dd);}result.append(dl);const p=document.createElement('p');p.textContent='Indicative only. Review the assumptions below.';result.append(p);}catch(error){result.textContent=error instanceof Error?error.message:'Check your entries.';}result.hidden=false;});form.querySelector('fieldset')?.removeAttribute('disabled');});
document.querySelectorAll<HTMLElement>('[data-checklist]').forEach(card=>{const checks=[...card.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];const count=card.querySelector('[data-count]');const sync=()=>{if(count)count.textContent=checks.filter(c=>c.checked).length+' of '+checks.length+' ready';};checks.forEach(c=>c.addEventListener('change',sync));card.querySelector('[data-reset-check]')?.addEventListener('click',()=>{checks.forEach(c=>c.checked=false);sync();});sync();});
</script>
<style>.tool-card fieldset{border:0;margin:0;padding:0;min-width:0}.tools-hero{background:#090909;color:#f4f0e7;padding-block:clamp(2.5rem,6vw,5rem);border-bottom:1px solid #987744}.tools-hero .eyebrow{color:#dfbd7e}.tools-hero p{max-width:72ch}.tools-hero nav{display:flex;flex-wrap:wrap;gap:1rem;color:#dfbd7e;font-size:.85rem}.tools-warning{border-left:2px solid var(--gold-line);background:var(--surface);padding:1.2rem;margin-bottom:2.5rem}.tools-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.3rem;margin:1.5rem 0}.tool-card{min-width:0;border:1px solid var(--line);border-top:2px solid var(--gold-line);background:var(--surface);padding:clamp(1rem,2.5vw,1.75rem)}.tool-card h3{font-size:clamp(1.5rem,2.5vw,2rem)}.tool-card .eyebrow{font-size:.67rem}.tool-card button{min-height:44px;border:1px solid var(--gold-line);background:var(--strong);color:var(--on-strong);padding:.55rem .85rem}.tool-card button.secondary{background:transparent;color:var(--ink)}.tool-result{padding:1rem;border:1px solid var(--gold-line);background:var(--paper);overflow-wrap:anywhere}.tool-result dl{margin:0;display:grid;grid-template-columns:1fr auto;gap:.5rem}.tool-result dt{font-size:.82rem;color:var(--muted)}.tool-result dd{margin:0;font-weight:650}.tool-result p{font-size:.75rem;color:var(--muted);margin:.8rem 0 0}.assumptions{margin-top:1.3rem;border-top:1px solid var(--line);padding-top:.7rem;font-size:.84rem;color:var(--muted)}.assumptions summary{cursor:pointer;color:var(--gold)}.assumptions p{margin:.7rem 0}.check-item{display:flex;align-items:start;gap:.65rem;padding:.55rem 0;border-bottom:1px solid var(--line);font-size:.9rem}.check-item input{accent-color:var(--gold);margin-top:.35rem;width:18px;height:18px;flex-shrink:0}.check-item:last-of-type{margin-bottom:1rem}.glossary div{padding:.85rem 0;border-bottom:1px solid var(--line)}.glossary dt{font-weight:650;color:var(--gold)}.glossary dd{margin:0;color:var(--muted)}.official-link{display:flex;justify-content:space-between;gap:1rem;border:1px solid var(--line);padding:1rem;text-decoration:none;background:var(--surface)}.official-link span{color:var(--gold)}@media(max-width:720px){.tools-grid{grid-template-columns:1fr}.tool-result dl{grid-template-columns:1fr}.tool-result dd{padding-bottom:.35rem}}</style>
