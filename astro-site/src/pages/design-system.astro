---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PracticeCard from '../components/PracticeCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Button from '../components/Button.astro';
const colors=[['Paper','--paper'],['Surface','--surface'],['Ink','--ink'],['Muted','--muted'],['Gold','--gold'],['Border','--line']];
---
<BaseLayout title="Design system | Chambers of AK preview" description="Development component showcase.">
<section class="section wrap"><p class="eyebrow">AK-003 / Design study</p><h1>Clarity. Restraint.<br/>Professional character.</h1><div class="rule"></div><p class="measure muted">A proposed editorial visual language for Chambers of AK. This is a component showcase, not a public-facing service page. Toggle the theme in the header to inspect both modes.</p><div class="cluster"><Button href="#components">Explore components</Button><Button variant="outline" href="/">Preview home</Button></div></section>
<section class="section wrap" id="components"><SectionHeading eyebrow="01 / Foundations" title="Colour & typography" description="Warm neutral surfaces, restrained metallic accents and a strong serif hierarchy."/><div class="swatches">{colors.map(([name,token])=><div class="panel swatch"><div class="sample" style={'background:var('+token+')'}></div><strong>{name}</strong><small>{token}</small></div>)}</div><div class="panel type"><p class="eyebrow">Editorial typography</p><h2>The law, clearly explained.</h2><h3>Procedural guidance and legal analysis</h3><p class="measure">Body text uses a system sans-serif stack to remain readable and fast. Long-form legal articles will use a measured reading width, clear headings and accessible reference links.</p></div></section>
<section class="section wrap"><SectionHeading eyebrow="02 / Practice" title="Practice-area cards"/><div class="grid"><PracticeCard number="01" title="MSME disputes" description="Statutory delayed-payment mechanisms, MSEFC proceedings and related legal issues."/><PracticeCard number="02" title="Arbitration" description="Arbitral proceedings, interim measures, challenges and enforcement."/><PracticeCard number="03" title="Property & RERA" description="Legal issues concerning real estate, property disputes and statutory remedies."/></div></section>
<section class="section wrap"><SectionHeading eyebrow="03 / Editorial" title="Legal insights" description="Sample cards with existing article topics; artwork will be migrated separately."/><div class="grid"><ArticleCard title="MSME delayed payment: MSEFC vs civil suit vs arbitration" category="Practical guide" date="October 2026" excerpt="A comparison of recovery routes, statutory interest, procedure and enforcement."/><ArticleCard title="Partly reasoned arbitral award: Section 34 grounds and remedies" category="Procedure note" date="October 2026" excerpt="An overview of missing reasons, contradictory findings and available remedies."/></div></section>
<section class="section wrap"><SectionHeading eyebrow="04 / Controls" title="Buttons and form fields"/><div class="grid"><div class="panel stack"><div class="cluster"><Button>Primary</Button><Button variant="outline">Outline</Button><Button variant="text">Text link</Button></div><p class="muted">Visual examples only.</p></div><div class="panel stack"><label class="field">Name<input type="text" placeholder="Example only" autocomplete="off"/></label><label class="field">Subject<select><option>General information</option><option>Legal resource</option></select></label><label class="field">Message<textarea rows="3" placeholder="Non-submitting demonstration"></textarea></label><small>No information is transmitted or stored by this demonstration.</small></div></div></section>
</BaseLayout>
<style>.swatches{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:.7rem;margin-block:1.5rem}.swatch{padding:.75rem}.sample{height:66px;border:1px solid var(--line);margin-bottom:.6rem}.swatch small{display:block}.type{margin-top:1rem}</style>
