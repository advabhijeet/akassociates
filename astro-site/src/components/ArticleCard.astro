---
interface Props { title:string; category:string; date:string; excerpt:string; href?:string; image?:string; imageAlt?:string; }
const {title,category,date,excerpt,href,image,imageAlt=''}=Astro.props;
---
<article class="article">
 {image?<img src={image} alt={imageAlt} width="640" height="360" loading="lazy" decoding="async"/>:<div class="placeholder" aria-hidden="true"><span>§</span><span>LEGAL INSIGHTS</span></div>}
 <div class="content"><div class="cluster meta"><span class="eyebrow">{category}</span><small>{date}</small></div><h3>{href?<a href={href}>{title}</a>:title}</h3><p class="muted">{excerpt}</p></div>
</article>
<style>.article{border:1px solid var(--line);background:var(--surface);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow)}img,.placeholder{width:100%;aspect-ratio:16/9;object-fit:contain;background:#e9e0ce}.placeholder{display:grid;place-content:center;text-align:center;color:#54452f;gap:.25rem}.placeholder span:first-child{font:3.5rem var(--serif)}.placeholder span:last-child{font-size:.65rem;letter-spacing:.2em}.content{padding:1.4rem}.meta{justify-content:space-between;gap:.5rem;margin-bottom:.85rem}h3{margin-bottom:.6rem}h3 a{text-decoration:none}h3 a:hover{text-decoration:underline}p{font-size:.9rem;margin:0}</style>
