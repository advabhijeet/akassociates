---
import {legacy,contact} from '../data/site';
---
<footer><div class="wrap"><div class="footer-grid"><div><a href="/" class="footer-brand" aria-label="Chambers of AK home"><img class="footer-light" src="/assets/img/performance/logo-navbar-480.jpg" alt="Chambers of AK" width="480" height="89"/><img class="footer-dark" src="/assets/img/performance/logo-navbar-dark-480.jpg" alt="Chambers of AK" width="480" height="89"/></a><p class="muted">Advocates &amp; Legal Consultants<br/>Patna, Bihar, India</p></div><div><h3>Information</h3><a href={legacy('about.html')}>About</a><a href="/practice.html">Practice areas</a><a href="/legal-updates.html">Legal insights</a><a href={legacy('courts.html')}>Courts &amp; forums</a></div><div><h3>Resources &amp; policies</h3><a href={legacy('document-checklists.html')}>Document checklists</a><a href={legacy('faq.html')}>FAQs</a><a href={legacy('privacy-policy.html')}>Privacy policy</a><a href={legacy('terms.html')}>Terms</a><a href={legacy('disclaimer.html')}>Disclaimer</a></div><div><h3>Contact details</h3><a href={'tel:'+contact.tel}>{contact.phone}</a><a href={'mailto:'+contact.email}>{contact.email}</a></div></div><div class="footnote"><small>© {new Date().getFullYear()} Chambers of AK. General information only; not legal advice or solicitation.</small><small>Development preview · <a href="/design-system.html">Design system</a> · <a href={legacy('')}>Live website</a></small></div></div></footer>
<style>footer{border-top:1px solid var(--line);padding-block:3rem 1.5rem;background:var(--surface)}.footer-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));gap:2rem}h3{font-size:1.25rem}a{display:block;font-size:.86rem;overflow-wrap:anywhere;margin:.35rem 0}.footnote{border-top:1px solid var(--line);margin-top:2rem;padding-top:1rem;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}.footnote a{display:inline;font-size:inherit}
footer{background:var(--brand-header);border-top:1px solid var(--brand-border)}
.footer-brand{max-width:245px;margin:0 0 1rem}.footer-light{mix-blend-mode:multiply}.footer-dark{display:none}:global([data-theme="dark"]) .footer-dark{display:block;mix-blend-mode:screen}:global([data-theme="dark"]) .footer-light{display:none}
.footer-grid h3{color:var(--gold);font-size:1.15rem}
.footer-grid a:hover{color:var(--gold)}
</style>
