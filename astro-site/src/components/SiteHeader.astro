---
import ThemeToggle from './ThemeToggle.astro';
---
<header class="site-header"><div class="wrap header-row"><a class="wordmark" href="/" aria-label="Chambers of AK home"><span class="mark" aria-hidden="true">AK</span><span><strong>Chambers of AK</strong><small>Advocates &amp; Legal Consultants</small></span></a><nav aria-label="Preview navigation"><a href="/">Home</a><a href="/design-system.html">Design system</a><ThemeToggle /></nav></div></header>
<style>.site-header{border-bottom:1px solid var(--line);background:var(--surface)}.header-row,.wordmark,nav{display:flex;align-items:center;gap:1rem}.header-row{justify-content:space-between;flex-wrap:wrap;padding-block:1.15rem}.wordmark{text-decoration:none;gap:.8rem}.mark{display:grid;place-items:center;width:48px;height:48px;border:1px solid var(--gold-line);font:1.35rem var(--serif);color:var(--gold)}strong{display:block;font:1.35rem var(--serif)}small{display:block;font-size:.68rem;letter-spacing:.04em}nav{flex-wrap:wrap;gap:1rem}nav a{font-size:.85rem;text-decoration:none;min-height:44px;display:flex;align-items:center}nav a:hover{text-decoration:underline}@media(max-width:600px){nav{width:100%;justify-content:space-between;gap:.5rem}}</style>
