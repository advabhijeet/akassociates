---
import ThemeToggle from './ThemeToggle.astro';
import {navigation} from '../data/site';
const links=navigation.filter(([label])=>label!=='Home');
---
<header class="site-header">
<div class="mast"><div class="wrap mast-row"><span>Independent legal chambers · Patna, Bihar</span><span>Advocates &amp; Legal Consultants</span></div></div>
<div class="wrap header-row"><a class="wordmark" href="/" aria-label="Chambers of AK home"><img class="light-logo" src="/assets/img/performance/logo-navbar-480.jpg" alt="Chambers of AK" width="480" height="89"/><img class="dark-logo" src="/assets/img/performance/logo-navbar-dark-480.jpg" alt="Chambers of AK" width="480" height="89"/></a>
<nav class="desktop-nav" aria-label="Main navigation">{links.map(([label,href])=><a href={href.startsWith('#')?'/'+href:href}>{label}</a>)}</nav>
<div class="header-tools"><ThemeToggle/><details class="mobile-nav"><summary>Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile navigation">{navigation.map(([label,href])=><a href={href.startsWith('#')?'/'+href:href}>{label}</a>)}</nav></details></div></div>
</header>
<script>
document.querySelectorAll('.mobile-nav nav a').forEach(a=>a.addEventListener('click',()=>a.closest('details')?.removeAttribute('open')));
</script>
<style>
.site-header{position:sticky;top:0;z-index:5;background:var(--surface);border-bottom:1px solid var(--line)}
.mast{background:#202321;color:#e5dbc7;font-size:.66rem;letter-spacing:.12em;text-transform:uppercase}.mast-row{display:flex;justify-content:space-between;gap:.5rem;padding-block:.48rem}
.header-row{display:flex;align-items:center;justify-content:space-between;gap:1.3rem;min-height:82px}
.wordmark{display:block;width:clamp(180px,21vw,260px);flex-shrink:0}.wordmark img{width:100%;height:auto}.dark-logo{display:none}:global([data-theme="dark"]) .dark-logo{display:block}:global([data-theme="dark"]) .light-logo{display:none}
.desktop-nav,.header-tools{display:flex;align-items:center;gap:clamp(.6rem,1.4vw,1.3rem)}nav a{text-decoration:none;font-size:.84rem;min-height:44px;display:flex;align-items:center}nav a:hover{color:var(--gold);text-decoration:underline;text-underline-offset:.5rem}
.mobile-nav{display:none;position:relative}.mobile-nav summary{list-style:none;cursor:pointer;min-height:44px;display:flex;align-items:center;gap:.5rem;font-size:.8rem;border:1px solid var(--line);padding:.5rem .75rem}.mobile-nav summary::-webkit-details-marker{display:none}.mobile-nav nav{position:absolute;right:0;top:calc(100% + .7rem);min-width:220px;background:var(--surface);border:1px solid var(--line);padding:.75rem 1.1rem;box-shadow:var(--shadow)}.mobile-nav nav a{border-bottom:1px solid var(--line)}
@media(max-width:1050px){.desktop-nav{display:none}.mobile-nav{display:block}}@media(max-width:560px){.mast-row span:last-child{display:none}.mast-row{justify-content:center}.header-row{min-height:70px;gap:.5rem}.header-tools{gap:.35rem}.wordmark{width:min(43vw,200px)}.mobile-nav summary{padding:.4rem .5rem}}
</style>
