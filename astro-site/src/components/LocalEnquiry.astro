<section class="detail-section" id="preview-message"><p class="eyebrow">Local message preparation</p><h2>Prepare an enquiry</h2><p>Preview only. No information is transmitted or stored. Do not enter confidential or privileged material.</p><noscript><p>JavaScript is required to prepare a local message.</p></noscript><form data-local-enquiry class="panel stack" method="post"><fieldset disabled class="stack"><label class="field">Matter type<select name="type" required><option value="">Choose matter type</option>{['MSME','Arbitration','RERA','Cheque bounce','Commercial recovery','Property / Civil','Other'].map(x=><option>{x}</option>)}</select></label><label class="field">City / forum<input name="forum"/></label><label class="field">Relevant dates and stage<textarea name="dates" rows="3"/></label><label class="field">Brief non-confidential summary<textarea name="summary" rows="4" required/></label><label><input type="checkbox" required/> I understand this is a local preparation tool, not legal advice or engagement.</label><button type="submit">Prepare message</button><label class="field">Prepared message<textarea data-enquiry-text readonly rows="8"/></label><button type="button" data-enquiry-copy disabled>Copy message</button><p role="status" data-enquiry-status></p></fieldset></form></section>
<script>
const form=document.querySelector<HTMLFormElement>('[data-local-enquiry]');const output=form?.querySelector<HTMLTextAreaElement>('[data-enquiry-text]');const copy=form?.querySelector<HTMLButtonElement>('[data-enquiry-copy]');const status=form?.querySelector<HTMLElement>('[data-enquiry-status]');
form?.addEventListener('submit',e=>{e.preventDefault();if(!form||!output||!copy)return;const d=new FormData(form);output.value=['Matter type: '+d.get('type'),'City / forum: '+d.get('forum'),'Dates / stage: '+d.get('dates'),'Summary: '+d.get('summary')].join('\n\n');copy.disabled=false;if(status)status.textContent='Message prepared locally. Nothing has been sent.';});
form?.addEventListener('input',e=>{if(e.target!==output&&output&&copy){output.value='';copy.disabled=true;if(status)status.textContent='';}});
form?.querySelector('fieldset')?.removeAttribute('disabled');
copy?.addEventListener('click',async()=>{if(!output||!status)return;try{await navigator.clipboard.writeText(output.value);status.textContent='Copied.';}catch{output.select();status.textContent='Select and copy manually.';}});
</script><style>fieldset{border:0;margin:0;padding:0;min-width:0}button{min-height:44px;background:var(--surface);color:var(--ink);border:1px solid var(--gold-line);padding:.5rem 1rem;justify-self:start}</style>